# ================================================
# CONFIGURAÇÕES DO AMBIENTE
# Copie este arquivo para .env e preencha os valores
# ================================================

# Servidor
PORT=3000
NODE_ENV=development

# Sessão (troque por uma string aleatória segura em produção)
SESSION_SECRET=minha-casa-minha-familia-meu-lar-2024

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=casa2024

# ================================================
# MERCADO PAGO
# Configure aqui suas credenciais do Mercado Pago
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# ================================================
MERCADOPAGO_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI
MERCADOPAGO_PUBLIC_KEY=SUA_PUBLIC_KEY_AQUI

# Link direto para contribuições via Mercado Pago (link de pagamento ou link de doação)
# Crie em: https://www.mercadopago.com.br/tools/create
MERCADOPAGO_LINK_CONTRIBUICAO=https://mpago.la/SEU_LINK_AQUI

# ================================================
# CONFIGURAÇÕES DO SITE
# ================================================
SITE_URL=http://localhost:3000
SITE_NOME=Casa Nova Geovane & Lidiane
META_TOTAL=15000
