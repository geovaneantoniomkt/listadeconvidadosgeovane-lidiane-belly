<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product ? 'Editar' : 'Novo' %> Produto | Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/pages/admin.css">
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <%- include('./sidebar', { currentPage: 'products' }) %>

  <main class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-page-title"><%= product ? 'Editar Produto' : 'Novo Produto' %></h1>
      <div class="admin-topbar-actions">
        <a href="/admin/produtos" class="btn btn-ghost btn-sm">← Voltar</a>
      </div>
    </div>

    <div class="admin-content">
      <div class="admin-section">
        <div class="admin-section-body">
          <form method="POST"
                action="<%= product ? '/admin/produtos/' + product.id : '/admin/produtos' %>"
                enctype="multipart/form-data"
                class="admin-form">

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Nome do produto <span>*</span></label>
                <input type="text" name="name" class="form-control" required
                       value="<%= product ? product.name : '' %>" placeholder="Ex: Sofá 3 Lugares">
              </div>
              <div class="form-group">
                <label class="form-label">Categoria</label>
                <select name="category_id" class="form-control">
                  <option value="">Sem categoria</option>
                  <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>" <%= product && product.category_id == cat.id ? 'selected' : '' %>>
                    <%= cat.icon %> <%= cat.name %>
                  </option>
                  <% }) %>
                </select>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Preço estimado (R$) <span>*</span></label>
                <input type="number" name="price" class="form-control" required step="0.01" min="0"
                       value="<%= product ? product.price : '' %>" placeholder="0,00">
              </div>
              <div class="form-group">
                <label class="form-label">Status</label>
                <select name="status" class="form-control">
                  <option value="disponivel" <%= !product || product.status === 'disponivel' ? 'selected' : '' %>>Disponível</option>
                  <option value="reservado" <%= product && product.status === 'reservado' ? 'selected' : '' %>>Reservado</option>
                  <option value="aguardando_validacao" <%= product && product.status === 'aguardando_validacao' ? 'selected' : '' %>>Aguardando validação</option>
                  <option value="comprado" <%= product && product.status === 'comprado' ? 'selected' : '' %>>Comprado</option>
                </select>
              </div>
            </div>

            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Badge especial</label>
                <select name="badge" class="form-control">
                  <option value="">Sem badge</option>
                  <option value="prioridade" <%= product && product.badge === 'prioridade' ? 'selected' : '' %>>🔴 Prioridade</option>
                  <option value="mais-desejado" <%= product && product.badge === 'mais-desejado' ? 'selected' : '' %>>⭐ Mais desejado</option>
                  <option value="quase-resolvido" <%= product && product.badge === 'quase-resolvido' ? 'selected' : '' %>>✅ Quase resolvido</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">
                  <input type="checkbox" name="priority" value="1" <%= product && product.priority ? 'checked' : '' %> style="margin-right: 8px;">
                  Produto prioritário (aparece em destaque)
                </label>
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">Descrição curta</label>
              <textarea name="description" class="form-control" rows="2"
                        placeholder="Descrição objetiva do produto"><%= product ? product.description || '' : '' %></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Texto criativo (tom divertido para a página do produto)</label>
              <textarea name="creative_text" class="form-control" rows="4"
                        placeholder="Ex: A Lidiane sonha com essa geladeira há dois anos..."><%= product ? product.creative_text || '' : '' %></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Especificações técnicas (JSON)</label>
              <textarea name="specs" class="form-control" rows="6"
                        placeholder='{"Tamanho": "3 lugares", "Material": "Suede", "Modelo exato": "XYZ 123"}'
                        style="font-family: monospace; font-size: var(--text-sm);"><%= product ? product.specs || '{}' : '{}' %></textarea>
              <p class="form-hint">Formato JSON. Use "Modelo exato" para destacar o modelo correto.</p>
            </div>

            <div class="form-group">
              <label class="form-label">Onde comprar — Links das lojas</label>
              <div id="suppliers-list" style="display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-3);">
                <%
                  var suppliersArr = [];
                  try { suppliersArr = JSON.parse(product && product.suppliers ? product.suppliers : '[]'); } catch(e) {}
                  suppliersArr.forEach(function(s) {
                %>
                <div style="display:flex; gap:8px; align-items:center;">
                  <input type="text" name="supplier_name[]" placeholder="Nome da loja (ex: Magazine Luiza)"
                    value="<%= s.name || '' %>" class="form-control" style="flex:1;">
                  <input type="text" name="supplier_url[]" placeholder="Link do produto (https://...)"
                    value="<%= s.url || '' %>" class="form-control" style="flex:2;">
                  <button type="button" onclick="this.parentElement.remove()"
                    style="background:none;border:none;cursor:pointer;font-size:1.5rem;color:#dc3545;padding:4px 8px;line-height:1;">×</button>
                </div>
                <% }); %>
              </div>
              <button type="button" onclick="addSupplier()" class="btn btn-outline btn-sm">
                ➕ Adicionar loja
              </button>
              <p class="form-hint">Adicione os links das lojas onde o convidado pode comprar este produto.</p>
            </div>

            <div class="form-group">
              <label class="form-label">Imagem do produto</label>
              <input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png,.webp">
              <% if (product && product.image_url) { %>
                <p class="form-hint">Imagem atual: <%= product.image_url %></p>
              <% } %>
            </div>

            <div style="display: flex; gap: var(--space-3); margin-top: var(--space-4);">
              <button type="submit" class="btn btn-primary btn-lg">
                <%= product ? '💾 Salvar alterações' : '➕ Criar produto' %>
              </button>
              <a href="/admin/produtos" class="btn btn-ghost btn-lg">Cancelar</a>
            </div>

          </form>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
<script>
  function addSupplier() {
    var list = document.getElementById('suppliers-list');
    var row  = document.createElement('div');
    row.style.cssText = 'display:flex; gap:8px; align-items:center;';
    var nameInput = document.createElement('input');
    nameInput.type = 'text';
    nameInput.name = 'supplier_name[]';
    nameInput.placeholder = 'Nome da loja (ex: Magazine Luiza)';
    nameInput.className = 'form-control';
    nameInput.style.flex = '1';
    var urlInput = document.createElement('input');
    urlInput.type = 'text';
    urlInput.name = 'supplier_url[]';
    urlInput.placeholder = 'Link do produto (https://...)';
    urlInput.className = 'form-control';
    urlInput.style.flex = '2';
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.innerHTML = '&times;';
    btn.style.cssText = 'background:none;border:none;cursor:pointer;font-size:1.5rem;color:#dc3545;padding:4px 8px;line-height:1;';
    btn.onclick = function() { row.remove(); };
    row.appendChild(nameInput);
    row.appendChild(urlInput);
    row.appendChild(btn);
    list.appendChild(row);
  }
</script>
</body>
</html>
