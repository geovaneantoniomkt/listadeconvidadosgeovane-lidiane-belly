<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Configurações | Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/pages/admin.css">
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <%- include('./sidebar', { currentPage: 'settings' }) %>

  <main class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-page-title">Configurações</h1>
    </div>

    <div class="admin-content">
      <% if (flash && flash.success && flash.success.length > 0) { %>
        <div class="alert alert-success"><%= flash.success[0] %></div>
      <% } %>

      <form method="POST" action="/admin/configuracoes" class="admin-form">

        <!-- Meta -->
        <div class="admin-section">
          <div class="admin-section-header">
            <h2 class="admin-section-title">🎯 Meta de arrecadação</h2>
          </div>
          <div class="admin-section-body">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label">Valor total da meta (R$)</label>
                <input type="number" name="meta_total" class="form-control"
                       value="<%= settings.meta_total || 15000 %>"
                       step="100" min="0" placeholder="15000">
                <p class="form-hint">Valor total que a família quer arrecadar</p>
              </div>
              <div class="form-group">
                <label class="form-label">Cálculo da meta</label>
                <select name="goal_calculation" class="form-control">
                  <option value="total" <%= settings.goal_calculation === 'total' ? 'selected' : '' %>>
                    Total (dinheiro + itens comprados)
                  </option>
                  <option value="confirmado" <%= settings.goal_calculation === 'confirmado' ? 'selected' : '' %>>
                    Apenas dinheiro confirmado
                  </option>
                </select>
              </div>
            </div>
          </div>
        </div>

        <!-- Mercado Pago -->
        <div class="admin-section">
          <div class="admin-section-header">
            <h2 class="admin-section-title">💳 Mercado Pago</h2>
          </div>
          <div class="admin-section-body">
            <div class="alert alert-info" style="margin-bottom: var(--space-5);">
              ℹ️ Configure suas credenciais no arquivo <code>.env</code>. O link de pagamento abaixo é usado nos botões do site.
              Crie em: <strong>mercadopago.com.br → Ferramentas → Link de pagamento</strong>
            </div>
            <div class="form-group">
              <label class="form-label">Link de contribuição (Mercado Pago)</label>
              <input type="url" name="mercadopago_link" class="form-control"
                     value="<%= settings.mercadopago_link || '' %>"
                     placeholder="https://mpago.la/SEU_LINK">
              <p class="form-hint">Link de pagamento ou doação do Mercado Pago. Aparece nos botões "Contribuir" do site.</p>
            </div>
          </div>
        </div>

        <!-- Sorteio -->
        <div class="admin-section">
          <div class="admin-section-header">
            <h2 class="admin-section-title">🎰 Sorteio</h2>
          </div>
          <div class="admin-section-body">
            <div class="form-group">
              <label class="form-label">Preço por número (R$)</label>
              <input type="number" name="raffle_price_per_number" class="form-control"
                     value="<%= settings.raffle_price_per_number || 10 %>"
                     step="0.50" min="1" placeholder="10">
            </div>
          </div>
        </div>

        <!-- Contato -->
        <div class="admin-section">
          <div class="admin-section-header">
            <h2 class="admin-section-title">📱 Contato</h2>
          </div>
          <div class="admin-section-body">
            <div class="form-group">
              <label class="form-label">Número WhatsApp (com código do país)</label>
              <input type="text" name="whatsapp_number" class="form-control"
                     value="<%= settings.whatsapp_number || '' %>"
                     placeholder="5511999999999">
              <p class="form-hint">Ex: 5511999999999 (sem espaços ou caracteres especiais)</p>
            </div>
          </div>
        </div>

        <!-- Popups -->
        <div class="admin-section">
          <div class="admin-section-header">
            <h2 class="admin-section-title">💬 Popups</h2>
          </div>
          <div class="admin-section-body">
            <div class="form-group">
              <label class="form-label" style="display: flex; align-items: center; gap: var(--space-3);">
                <input type="checkbox" name="popup_enabled" value="1"
                       <%= settings.popup_enabled === '1' ? 'checked' : '' %>
                       style="width: 18px; height: 18px;">
                Ativar popups de boas-vindas e intenção de saída
              </label>
              <p class="form-hint">Quando ativo, exibe um popup carinhoso para os visitantes.</p>
            </div>
          </div>
        </div>

        <div style="padding: 0 var(--space-6) var(--space-6);">
          <button type="submit" class="btn btn-primary btn-lg">💾 Salvar configurações</button>
        </div>

      </form>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
</body>
</html>
