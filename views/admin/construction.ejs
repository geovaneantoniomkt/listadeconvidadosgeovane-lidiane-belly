<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Andamento da Obra | Admin</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/pages/admin.css">
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <%- include('./sidebar', { currentPage: 'admin-construction' }) %>

  <main class="admin-main">
    <div class="admin-topbar">
      <h1 class="admin-page-title">🏗️ Andamento da Obra</h1>
    </div>

    <div class="admin-content">

      <% if (flash.success) { %>
        <div class="alert alert-success"><%= flash.success %></div>
      <% } %>

      <form method="POST" action="/admin/obra">

        <!-- Informações gerais -->
        <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-6);">
          <h2 style="font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--space-6);">Informações Gerais</h2>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-4);">
            <div class="form-group">
              <label class="form-label">Progresso Geral (%)</label>
              <input type="number" name="overall" class="form-control" step="0.01" min="0" max="100"
                value="<%= settings.construction_overall || '0' %>" required>
              <small class="form-hint">Ex: 77.32 — aparece na barra principal</small>
            </div>
            <div class="form-group">
              <label class="form-label">Previsão de Entrega das Chaves</label>
              <input type="date" name="delivery_date" class="form-control"
                value="<%= settings.delivery_date || '' %>">
              <small class="form-hint">Data com carência incluída</small>
            </div>
            <div class="form-group">
              <label class="form-label">Última Atualização</label>
              <input type="text" name="last_update" class="form-control"
                placeholder="Ex: Abril/2026" value="<%= settings.construction_last_update || '' %>">
              <small class="form-hint">Mês e ano do último relatório</small>
            </div>
          </div>
        </div>

        <!-- Etapas da obra -->
        <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-6);">
          <h2 style="font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--space-6);">Etapas da Construção</h2>

          <div style="display: flex; flex-direction: column; gap: var(--space-4);">
            <% stages.forEach(stage => { %>
            <div style="display: grid; grid-template-columns: 1fr auto; align-items: center; gap: var(--space-4); padding: var(--space-4); background: var(--color-bg-subtle); border-radius: var(--radius-lg);">
              <div>
                <div style="font-weight: 600; margin-bottom: var(--space-2);"><%= stage.name %></div>
                <div style="background: var(--color-border); border-radius: var(--radius-full); height: 8px; overflow: hidden;">
                  <div style="height: 100%; width: <%= stage.percentage %>%; background: var(--color-primary); border-radius: var(--radius-full); transition: width 0.3s;"></div>
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: var(--space-2);">
                <input type="hidden" name="stage_id[]" value="<%= stage.id %>">
                <input type="number" name="stage_percentage[]" class="form-control"
                  style="width: 90px; text-align: center;"
                  step="0.01" min="0" max="100"
                  value="<%= stage.percentage %>">
                <span style="color: var(--color-text-muted); font-size: var(--text-sm);">%</span>
              </div>
            </div>
            <% }) %>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg">
          💾 Salvar Alterações
        </button>

      </form>

    </div>
  </main>
</div>

</body>
</html>
