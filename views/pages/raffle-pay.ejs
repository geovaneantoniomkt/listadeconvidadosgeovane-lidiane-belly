<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('../partials/gtm-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pagar Sorteio | Casa Nova Geovane & Lidiane 🏠</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏠</text></svg>">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<%- include('../partials/gtm-body') %>

<%- include('../partials/header') %>

<div class="header-offset section">
<div class="container">
<div style="max-width: 560px; margin: 0 auto;">

  <!-- Header -->
  <div class="fade-in" style="text-align: center; margin-bottom: var(--space-8);">
    <div style="font-size: 3rem; margin-bottom: var(--space-4);">🎰</div>
    <h1 style="font-family: var(--font-serif); font-size: var(--text-3xl); color: var(--color-text); margin-bottom: var(--space-3);">
      Quase lá, <strong><%= nome %>!</strong>
    </h1>
    <p style="color: var(--color-text-secondary); font-size: var(--text-lg);">
      Seus números estão reservados por <strong>30 minutos</strong>.<br>
      Pague agora para garantir sua participação!
    </p>
  </div>

  <!-- Resumo dos números -->
  <div class="card fade-in" style="padding: var(--space-6); margin-bottom: var(--space-6); background: var(--color-bg-warm);">
    <h2 style="font-size: var(--text-lg); margin-bottom: var(--space-4);">📋 Resumo do pedido</h2>

    <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-3); font-size: var(--text-sm); color: var(--color-text-muted);">
      <span>Números escolhidos (<%= qtd %>)</span>
      <span>R$ <%= total.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %></span>
    </div>

    <div style="display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-5);">
      <% numeros.forEach(n => { %>
        <span style="background: var(--color-primary); color: white; border-radius: var(--radius-full); padding: 4px 12px; font-size: var(--text-sm); font-weight: 600;">
          <%= n %>
        </span>
      <% }) %>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; padding-top: var(--space-4); border-top: 2px solid var(--color-border);">
      <span style="font-weight: 700; font-size: var(--text-lg);">Total a pagar</span>
      <span style="font-family: var(--font-serif); font-size: var(--text-2xl); font-weight: 700; color: var(--color-success);">
        R$ <%= total.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
      </span>
    </div>
  </div>

  <!-- Contador regressivo -->
  <div class="card fade-in" style="padding: var(--space-5); margin-bottom: var(--space-6); background: var(--color-warning-soft); border: 1px solid var(--color-warning); text-align: center;">
    <p style="font-size: var(--text-sm); color: var(--color-warning); font-weight: 600; margin-bottom: var(--space-2);">
      ⏱️ Sua reserva expira em:
    </p>
    <div id="countdown" style="font-family: var(--font-serif); font-size: var(--text-3xl); font-weight: 700; color: var(--color-warning);">
      30:00
    </div>
    <p style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-2);">
      Após esse tempo os números ficam disponíveis para outra pessoa
    </p>
  </div>

  <!-- Botão de pagamento -->
  <div class="fade-in" style="margin-bottom: var(--space-6);">
    <% if (mpLink && mpLink !== '#') { %>
      <a href="<%= mpLink %>" target="_blank" class="btn btn-primary btn-full btn-lg" style="font-size: var(--text-xl); padding: var(--space-5);">
        💳 Pagar R$ <%= total.toLocaleString('pt-BR', {minimumFractionDigits: 2}) %> agora
      </a>
      <p style="text-align: center; font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-3);">
        Aceita Pix, débito e crédito via Mercado Pago
      </p>
    <% } else { %>
      <div class="alert alert-warning">
        ⚠️ Link de pagamento não configurado. Entre em contato pelo WhatsApp.
      </div>
    <% } %>
  </div>

  <!-- Instruções pós-pagamento -->
  <div class="card fade-in" style="padding: var(--space-6); border-left: 4px solid var(--color-primary);">
    <h3 style="font-size: var(--text-base); font-weight: 700; margin-bottom: var(--space-4);">
      ✅ Após pagar, o que acontece?
    </h3>
    <ul style="list-style: none; display: flex; flex-direction: column; gap: var(--space-3);">
      <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
        <span style="font-size: 1.25rem;">1️⃣</span>
        <span style="font-size: var(--text-sm); color: var(--color-text-secondary);">
          Clique no botão acima e finalize o pagamento no Mercado Pago
        </span>
      </li>
      <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
        <span style="font-size: 1.25rem;">2️⃣</span>
        <span style="font-size: var(--text-sm); color: var(--color-text-secondary);">
          Salve o comprovante do pagamento (print ou PDF)
        </span>
      </li>
      <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
        <span style="font-size: 1.25rem;">3️⃣</span>
        <span style="font-size: var(--text-sm); color: var(--color-text-secondary);">
          Envie o comprovante pelo WhatsApp para confirmar sua participação:
          <% if (settings.whatsapp_number) { %>
            <br><a href="https://wa.me/<%= settings.whatsapp_number.replace(/\D/g,'') %>?text=Olá!%20Paguei%20os%20números%20<%= encodeURIComponent(numeros.join(', ')) %>%20do%20sorteio.%20Nome%3A%20<%= encodeURIComponent(nome) %>"
               target="_blank"
               style="color: var(--color-primary); font-weight: 600; text-decoration: underline;">
              📱 Clique aqui para abrir o WhatsApp
            </a>
          <% } %>
        </span>
      </li>
      <li style="display: flex; gap: var(--space-3); align-items: flex-start;">
        <span style="font-size: 1.25rem;">4️⃣</span>
        <span style="font-size: var(--text-sm); color: var(--color-text-secondary);">
          Após confirmação, seus números ficam marcados como pagos no sorteio!
        </span>
      </li>
    </ul>
  </div>

  <!-- Voltar -->
  <div style="text-align: center; margin-top: var(--space-6);">
    <a href="/sorteio" style="font-size: var(--text-sm); color: var(--color-text-muted);">
      ← Voltar e escolher outros números
    </a>
  </div>

</div>
</div>
</div>

<%- include('../partials/footer') %>

<script>
// Contador regressivo de 30 minutos
let totalSeconds = 30 * 60;
const countdown = document.getElementById('countdown');

const timer = setInterval(() => {
  totalSeconds--;
  const m = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
  const s = (totalSeconds % 60).toString().padStart(2, '0');
  countdown.textContent = `${m}:${s}`;

  if (totalSeconds <= 300) { // últimos 5 minutos: vermelho
    countdown.style.color = 'var(--color-error, #dc2626)';
  }

  if (totalSeconds <= 0) {
    clearInterval(timer);
    countdown.textContent = 'Expirado!';
    document.querySelector('.btn-primary')?.setAttribute('disabled', 'disabled');
    document.querySelector('.btn-primary')?.classList.add('btn-disabled');
    alert('Sua reserva expirou. Por favor, volte ao sorteio e escolha seus números novamente.');
    window.location.href = '/sorteio';
  }
}, 1000);
</script>
<script src="/js/main.js"></script>
</body>
</html>
