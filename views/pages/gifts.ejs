<!DOCTYPE html>
<html lang="pt-BR">
<head>
<%- include('../partials/gtm-head') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lista de Presentes | Casa Nova Geovane & Lidiane 🏠</title>
  <meta name="description" content="Escolha um presente para a família Geovane, Lidiane e Belly. Lista completa com opções para todos os gostos e bolsos.">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏠</text></svg>">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<%- include('../partials/gtm-body') %>

<%- include('../partials/header') %>

<div class="header-offset">

  <!-- Page Header -->
  <section class="section-sm" style="background: var(--color-bg-warm); border-bottom: 1px solid var(--color-border);">
    <div class="container">
      <div class="section-header" style="margin-bottom: 0;">
        <span class="section-eyebrow">🎁 Lista completa</span>
        <h1 class="section-title">Lista de Presentes</h1>
        <p class="section-subtitle">
          Cada item foi escolhido com carinho. Compre direto no fornecedor ou contribua com qualquer valor.
        </p>
      </div>

      <!-- Status counters -->
      <div style="display: flex; justify-content: center; gap: var(--space-6); margin-top: var(--space-6); flex-wrap: wrap;">
        <div style="text-align: center;">
          <div style="font-family: var(--font-serif); font-size: var(--text-2xl); font-weight: 700; color: var(--color-success);"><%= statusCounts.disponivel %></div>
          <div style="font-size: var(--text-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em;">Disponíveis</div>
        </div>
        <div style="text-align: center;">
          <div style="font-family: var(--font-serif); font-size: var(--text-2xl); font-weight: 700; color: var(--color-warning);"><%= statusCounts.reservado %></div>
          <div style="font-size: var(--text-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em;">Reservados</div>
        </div>
        <div style="text-align: center;">
          <div style="font-family: var(--font-serif); font-size: var(--text-2xl); font-weight: 700; color: var(--color-text-muted);"><%= statusCounts.comprado %></div>
          <div style="font-size: var(--text-xs); color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.06em;">Comprados ✅</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Filtros -->
  <div style="background: white; border-bottom: 1px solid var(--color-border); position: sticky; top: 64px; z-index: 100;">
    <div class="container" style="padding-top: var(--space-3); padding-bottom: var(--space-3);">

      <form method="GET" action="/presentes" id="filter-form">
        <!-- Linha principal: busca + botão filtrar + contagem -->
        <div style="display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap;">
          <div class="search-box" style="flex: 1; min-width: 180px;">
            <span class="search-icon">🔍</span>
            <input type="text" name="busca" class="form-control"
                   placeholder="Buscar presente..."
                   value="<%= filters.busca || '' %>">
          </div>

          <button type="button" id="filter-toggle" onclick="toggleFilters()"
            style="display:flex; align-items:center; gap:6px; background: var(--color-bg-warm); border: 1px solid var(--color-border); border-radius: var(--radius-full); padding: 8px 16px; cursor:pointer; font-size: var(--text-sm); font-weight:600; white-space:nowrap;">
            🎛️ Filtrar
            <% if (filters.categoria || filters.ordem) { %>
              <span style="background: var(--color-primary); color: white; border-radius: 50%; width:18px; height:18px; font-size:11px; display:flex; align-items:center; justify-content:center;">
                <%= (filters.categoria ? 1 : 0) + (filters.ordem && filters.ordem !== 'prioridade' ? 1 : 0) %>
              </span>
            <% } %>
          </button>

          <button type="submit" class="btn btn-primary btn-sm">Buscar</button>
          <% if (filters.busca || filters.categoria || filters.ordem) { %>
            <a href="/presentes" class="btn btn-ghost btn-sm">✕ Limpar</a>
          <% } %>

          <span style="font-size: var(--text-sm); color: var(--color-text-muted); margin-left: auto; white-space:nowrap;">
            <%= products.length %> item<%= products.length !== 1 ? 's' : '' %>
          </span>
        </div>

        <!-- Painel de filtros avançados (colapsável) -->
        <div id="filter-panel" style="display:<%= (filters.categoria || filters.ordem) ? 'flex' : 'none' %>; gap: var(--space-3); margin-top: var(--space-3); flex-wrap: wrap; padding: var(--space-3); background: var(--color-bg-warm); border-radius: var(--radius-lg);">
          <div style="flex:1; min-width:160px;">
            <label style="font-size:var(--text-xs); color:var(--color-text-muted); font-weight:600; display:block; margin-bottom:4px;">CATEGORIA</label>
            <select name="categoria" class="form-control" style="font-size:var(--text-sm);">
              <option value="">Todas as categorias</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.slug %>" <%= filters.categoria === cat.slug ? 'selected' : '' %>>
                  <%= cat.icon %> <%= cat.name %>
                </option>
              <% }) %>
            </select>
          </div>
          <div style="flex:1; min-width:160px;">
            <label style="font-size:var(--text-xs); color:var(--color-text-muted); font-weight:600; display:block; margin-bottom:4px;">ORDENAR POR</label>
            <select name="ordem" class="form-control" style="font-size:var(--text-sm);">
              <option value="prioridade" <%= !filters.ordem || filters.ordem === 'prioridade' ? 'selected' : '' %>>⭐ Prioridade</option>
              <option value="menor-preco" <%= filters.ordem === 'menor-preco' ? 'selected' : '' %>>💰 Menor preço</option>
              <option value="maior-preco" <%= filters.ordem === 'maior-preco' ? 'selected' : '' %>>💎 Maior preço</option>
              <option value="nome" <%= filters.ordem === 'nome' ? 'selected' : '' %>>🔤 A-Z</option>
            </select>
          </div>
        </div>

        <!-- Chips de status -->
        <div style="display: flex; gap: var(--space-2); flex-wrap: wrap; align-items: center; margin-top: var(--space-2);">
          <a href="/presentes?<%= new URLSearchParams({busca: filters.busca||'', categoria: filters.categoria||'', ordem: filters.ordem||''}).toString() %>"
             class="filter-chip <%= !filters.status ? 'active' : '' %>">Todos</a>
          <a href="/presentes?<%= new URLSearchParams({busca: filters.busca||'', categoria: filters.categoria||'', ordem: filters.ordem||'', status: 'disponivel'}).toString() %>"
             class="filter-chip <%= filters.status === 'disponivel' ? 'active' : '' %>">🟢 Disponíveis</a>
          <a href="/presentes?<%= new URLSearchParams({busca: filters.busca||'', categoria: filters.categoria||'', ordem: filters.ordem||'', status: 'reservado'}).toString() %>"
             class="filter-chip <%= filters.status === 'reservado' ? 'active' : '' %>">🟡 Reservados</a>
          <a href="/presentes?<%= new URLSearchParams({busca: filters.busca||'', categoria: filters.categoria||'', ordem: filters.ordem||'', status: 'comprado'}).toString() %>"
             class="filter-chip <%= filters.status === 'comprado' ? 'active' : '' %>">✅ Comprados</a>
        </div>

        <!-- Campo status oculto para preservar nos submits do form -->
        <input type="hidden" name="status" value="<%= filters.status || '' %>">
      </form>
    </div>
  </div>

  <!-- Lista de produtos -->
  <section class="section-sm">
    <div class="container">

      <% if (products.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon">🎁</div>
          <h3>Nenhum presente encontrado</h3>
          <p>Tente ajustar os filtros ou buscar por outro termo. A lista está cheia de opções incríveis!</p>
          <a href="/presentes" class="btn btn-primary">Ver todos os presentes</a>
        </div>

      <% } else { %>
        <div class="products-grid stagger-children">
          <% products.forEach(product => {
            const statusMap = {
              disponivel: { text: 'Disponível', cls: 'disponivel' },
              reservado: { text: 'Reservado', cls: 'reservado' },
              aguardando_validacao: { text: 'Em validação', cls: 'aguardando' },
              comprado: { text: 'Comprado ✅', cls: 'comprado' }
            };
            const st = statusMap[product.status] || statusMap.disponivel;
          %>
          <a href="/presentes/<%= product.id %>" class="product-card-link">
            <div class="card product-card card-img-zoom <%= product.status === 'comprado' ? 'comprado' : '' %>">

              <!-- Badges superiores -->
              <div class="product-badges">
                <% if (product.badge === 'mais-desejado') { %>
                  <span class="badge badge-mais-desejado">⭐ Mais desejado</span>
                <% } else if (product.badge === 'prioridade') { %>
                  <span class="badge badge-prioridade">🔴 Prioridade</span>
                <% } else if (product.badge === 'quase-resolvido') { %>
                  <span class="badge badge-quase-resolvido">✅ Quase!</span>
                <% } %>
              </div>

              <!-- Status badge -->
              <div class="product-status-float" style="position: absolute; top: var(--space-3); right: var(--space-3); z-index: 2;">
                <span class="badge badge-<%= st.cls %> badge-dot"><%= st.text %></span>
              </div>

              <!-- Imagem -->
              <div style="aspect-ratio: 4/3; overflow: hidden; background: var(--color-bg-subtle); position: relative; display: flex; align-items: center; justify-content: center;">
                <% if (product.image_url && product.image_url !== '/images/placeholder-product.jpg') { %>
                  <img src="<%= product.image_url %>" alt="<%= product.name %>"
                    style="width:100%; height:100%; object-fit:cover;">
                <% } else { %>
                  <span style="font-size: 3.5rem;"><%= product.category_icon || '🎁' %></span>
                <% } %>
                <% if (product.status === 'comprado') { %>
                  <div style="position: absolute; inset: 0; background: rgba(255,255,255,0.6); display: flex; align-items: center; justify-content: center; font-size: 3rem;">✅</div>
                <% } %>
              </div>

              <!-- Info -->
              <div class="product-body">
                <p class="product-category">
                  <%= product.category_icon %> <%= product.category_name || 'Outros' %>
                </p>
                <h3 class="product-name"><%= product.name %></h3>
                <p style="font-size: var(--text-sm); color: var(--color-text-muted); margin-bottom: var(--space-4); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                  <%= product.description %>
                </p>
                <div style="display: flex; align-items: center; justify-content: space-between;">
                  <div class="product-price">
                    R$ <%= parseFloat(product.price).toLocaleString('pt-BR', {minimumFractionDigits: 2}) %>
                  </div>
                  <span style="font-size: var(--text-sm); color: var(--color-primary); font-weight: 600;">
                    <%= product.status === 'comprado' ? 'Ver detalhes' : 'Presentear →' %>
                  </span>
                </div>
              </div>
            </div>
          </a>
          <% }) %>
        </div>
      <% } %>

    </div>
  </section>

  <!-- Banner contribuição livre -->
  <section class="section-sm" style="background: var(--color-bg-warm);">
    <div class="container">
      <div class="goal-preview" style="text-align: center;">
        <h2 style="font-family: var(--font-serif); color: white; font-size: var(--text-2xl); margin-bottom: var(--space-3);">
          Prefere contribuir com qualquer valor?
        </h2>
        <p style="color: rgba(255,255,255,0.75); margin-bottom: var(--space-6);">
          Aceita Pix, débito, crédito e parcelamento. Qualquer valor é recebido com muito carinho! 💝
        </p>
        <a href="/contribuir" class="btn btn-outline-white btn-lg">
          💳 Contribuir com qualquer valor
        </a>
      </div>
    </div>
  </section>

</div>

<%- include('../partials/footer') %>

<%- include('../partials/exit-popup') %>

<script>
function toggleFilters() {
  var panel = document.getElementById('filter-panel');
  panel.style.display = panel.style.display === 'none' ? 'flex' : 'none';
}
</script>

<!-- CTA Flutuante Mobile -->
<div class="floating-cta">
  <a href="/contribuir" class="btn btn-secondary" style="flex: 1;">
    💝 Contribuir
  </a>
  <a href="/sorteio" class="btn btn-accent" style="flex: 1;">
    🎰 Sorteio
  </a>
</div>

<script src="/js/main.js"></script>
</body>
</html>
