<!-- ================================================
     POPUP 1: Boas-vindas (1x por usuário — todas as páginas)
     ================================================ -->
<% if (settings && settings.popup_enabled === '1') { %>
<div class="popup-overlay" id="welcomePopup">
  <div class="popup">
    <button class="popup-close-x" onclick="closePopup('welcomePopup')">✕</button>
    <div class="popup-emoji">💝</div>
    <h2 class="popup-title">Psiu... antes de continuar!</h2>
    <p class="popup-text">
      Que bom te ver por aqui! 😄<br><br>
      Antes de explorar nossa listinha cheia de sonhos, que tal deixar uma
      ajudinha carinhosa na nossa <strong>caixinha especial</strong>?
      Prometemos usar com responsabilidade...
      ou pelo menos num jantar muito romântico com sobremesa dupla. 🍰
    </p>
    <div class="popup-actions">
      <a href="/contribuir"
         class="btn btn-secondary btn-full btn-lg"
         onclick="closePopup('welcomePopup')">
        💝 Quero ajudar a caixinha!
      </a>
      <button class="btn btn-ghost btn-full"
              onclick="closePopup('welcomePopup')">
        Vou fingir que não vi 🙈
      </button>
    </div>
  </div>
</div>
<% } %>
