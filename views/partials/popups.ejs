<!-- ================================================
     POPUPS — ENTRADA E INTENÇÃO DE SAÍDA
     ================================================ -->

<% if (settings && settings.popup_enabled === '1') { %>

<!-- POPUP 1: Boas-vindas / Contribuição extra -->
<div class="popup-overlay" id="welcomePopup">
  <div class="popup">
    <button class="popup-close-x" onclick="closePopup('welcomePopup')">✕</button>

    <div class="popup-emoji">💝</div>
    <h2 class="popup-title">Psiu... antes de continuar!</h2>
    <p class="popup-text">
      Que bom te ver por aqui! 😄<br><br>
      Antes de explorar nossa listinha cheia de sonhos, que tal deixar uma
      ajudinha carinhosa na nossa <strong>caixinha especial</strong>?
      Prometemos usar com responsabilidade...
      ou pelo menos num jantar muito romântico com sobremesa dupla. 🍰
    </p>
    <div class="popup-actions">
      <a href="<%= settings.mercadopago_link || '#' %>"
         target="_blank"
         class="btn btn-secondary btn-full btn-lg"
         onclick="closePopup('welcomePopup')">
        💝 Quero ajudar a caixinha!
      </a>
      <button class="btn btn-ghost btn-full"
              onclick="closePopup('welcomePopup')">
        Vou fingir que não vi 🙈
      </button>
    </div>
  </div>
</div>

<!-- POPUP 2: Intenção de saída -->
<div class="popup-overlay" id="exitPopup">
  <div class="popup">
    <button class="popup-close-x" onclick="closePopup('exitPopup')">✕</button>

    <div class="popup-emoji">🥺</div>
    <h2 class="popup-title">Ué, já vai embora?</h2>
    <p class="popup-text">
      Tem certeza mesmo? Vai deixar a gente aqui olhando pra lista de
      presentes sonhando sozinhos? 😅<br><br>
      Vai dizer que não sobrou nem uma ajudinha
      pra família garantir pelo menos <strong>um açaí de fim de semana</strong>?
      A Belly tá torcendo por você! 🍦
    </p>
    <div class="popup-actions">
      <a href="<%= settings.mercadopago_link || '#' %>"
         target="_blank"
         class="btn btn-primary btn-full btn-lg"
         onclick="closePopup('exitPopup')">
        💚 Tá bom, eu ajudo!
      </a>
      <a href="/presentes" class="btn btn-outline btn-full" onclick="closePopup('exitPopup')">
        Ver presentes primeiro 🎁
      </a>
      <button class="btn btn-ghost btn-full"
              onclick="closePopup('exitPopup')">
        Agora eu vou mesmo 😭
      </button>
    </div>
  </div>
</div>

<% } %>
